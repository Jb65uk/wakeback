{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dock server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/app.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "WAKEBACK_FLEET": "6",
        "WAKEBACK_DEBUG": "1",
        "WAKEBACK_DEMO_WIFI": "1"
      }
    }
  ]
}
